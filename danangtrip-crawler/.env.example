NODE_ENV=development

# Google Places API will be implemented in a later phase.
GOOGLE_PLACES_API_KEY=

# Optional future image providers.
PEXELS_API_KEY=
PEXELS_API_URL=https://api.pexels.com/v1/search
PEXELS_ENRICH_LIMIT=80
PEXELS_PHOTOS_PER_ITEM=3
PEXELS_REQUEST_DELAY_MS=750
PEXELS_STOP_ON_429=true
UNSPLASH_ACCESS_KEY=

# Staging database connection for future persistence.
DATABASE_URL=postgresql://user:password@localhost:5432/danangtrip

# Local dry-run output.
CRAWLER_OUTPUT_FILE=data/crawl-items.json

# Public OSM/Overpass APIs require a descriptive User-Agent.
CRAWLER_USER_AGENT=DanangTripCrawler/0.1 contact:admin@danangtrip.local
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
