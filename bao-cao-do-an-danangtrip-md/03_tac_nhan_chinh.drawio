        <mxCell id="user_actor" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="user_col">
          <mxGeometry x="90" y="60" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="user_desc" value="Đối tượng đã xác thực tài khoản, kế thừa toàn bộ vai trò của Khách truy cập và có quyền cá nhân." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];whiteSpace=wrap;fontSize=11;fontColor=#4B5563;" vertex="1" parent="user_col">
          <mxGeometry x="10" y="150" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="user_f1" value="• Kế thừa Khách truy cập&#10;• Quản lý hồ sơ &amp; đổi mật khẩu&#10;• Quản lý danh sách yêu thích&#10;• Quản lý giỏ hàng đặt tour&#10;• Đặt tour &amp; theo dõi đơn đặt&#10;• Thanh toán tự động (SePay/QR)&#10;• Xem &amp; tải hóa đơn đơn đặt&#10;• Gửi đánh giá địa điểm/tour&#10;• Nhận gợi ý &amp; thông báo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;align=left;spacingLeft=10;fontSize=12;fontColor=#064E3B;" vertex="1" parent="user_col">
          <mxGeometry x="15" y="230" width="190" height="260" as="geometry" />
