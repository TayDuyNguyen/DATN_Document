        <mxCell id="guest_desc" value="Đối tượng chưa đăng nhập vào hệ thống, chỉ thực hiện các chức năng tra cứu thông tin công khai." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];whiteSpace=wrap;fontSize=11;fontColor=#4B5563;" vertex="1" parent="guest_col">
          <mxGeometry x="10" y="150" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="guest_f1" value="• Xem trang chủ &amp; danh mục&#10;• Tìm kiếm địa điểm, tour&#10;• Xem chi tiết &amp; đánh giá&#10;• Xem bản đồ &amp; chỉ đường&#10;• Đọc các bài viết blog&#10;• Hỏi đáp chatbot thông minh&#10;• Gửi biểu mẫu liên hệ&#10;• Đăng ký / Đăng nhập" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;align=left;spacingLeft=10;fontSize=12;fontColor=#1E3A8A;" vertex="1" parent="guest_col">
          <mxGeometry x="15" y="230" width="190" height="260" as="geometry" />
        </mxCell>
        
        <!-- REGISTERED USER COLUMN -->
        <mxCell id="user_col" value="Người dùng đã đăng nhập (User)" style="swimlane;startSize=40;fillColor=#ECFDF5;strokeColor=#A7F3D0;rounded=1;fontStyle=1;fontSize=13;fontColor=#065F46;align=center;" vertex="1" parent="1">
