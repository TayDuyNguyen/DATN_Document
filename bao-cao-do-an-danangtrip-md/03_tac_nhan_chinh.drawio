        <mxCell id="admin_desc" value="Đối tượng quản lý toàn bộ hệ thống, vận hành nghiệp vụ du lịch và cấu hình hệ thống." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];whiteSpace=wrap;fontSize=11;fontColor=#4B5563;" vertex="1" parent="admin_col">
