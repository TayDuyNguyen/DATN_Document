        <!-- GUEST ACTOR COLUMN -->
        <mxCell id="guest_col" value="Khách truy cập (Guest)" style="swimlane;startSize=40;fillColor=#EFF6FF;strokeColor=#BFDBFE;rounded=1;fontStyle=1;fontSize=13;fontColor=#1E40AF;align=center;" vertex="1" parent="1">
