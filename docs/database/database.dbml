  ends_at timestamp
  status varchar(20) [not null, default: 'active']
  created_at timestamp
  updated_at timestamp

  indexes {
    code
    status
    (starts_at, ends_at)
  }

  Note: 'discount_type: percent|fixed. status: active|inactive|expired. Source: 2026_05_30_000002_create_promotions_table.php'
}

