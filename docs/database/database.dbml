Project danangtrip_api {
  database_type: "PostgreSQL"
  Note: "DB duy nhat cua he thong. Source of truth: D:/DATN/danangtrip-api/database/migrations | Last reviewed: 2026-05-31"
}

Table users {
  id bigint [pk, increment]
  username varchar(50) [not null, unique]
  email varchar(100) [not null, unique]
  password varchar [not null]
  full_name varchar(100) [not null]
  avatar varchar(255)
  phone varchar(20)
  birthdate date
  gender varchar(20)
  city varchar(100)
  role varchar(20) [not null, default: 'user']
  status varchar(20) [not null, default: 'pending']
  email_verified_at timestamp
  last_login_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    role
    status
    created_at
  }
}

Table password_reset_tokens {
  email varchar [pk]
  token varchar [not null]
  created_at timestamp
}

Table sessions {
  id varchar [pk]
  user_id bigint
  ip_address varchar(45)
  user_agent text
  payload text [not null]
  last_activity int [not null]

  indexes {
    user_id
    last_activity
  }
}

Table cache {
  key varchar [pk]
  value text [not null]
  expiration int [not null]

  indexes {
    expiration
  }
}

Table cache_locks {
  key varchar [pk]
  owner varchar [not null]
  expiration int [not null]

  indexes {
    expiration
  }
}

Table jobs {
  id bigint [pk, increment]
  queue varchar [not null]
  payload text [not null]
  attempts int [not null]
  reserved_at int
  available_at int [not null]
  created_at int [not null]

  indexes {
    queue
  }
}

Table job_batches {
  id varchar [pk]
  name varchar [not null]
  total_jobs int [not null]
  pending_jobs int [not null]
  failed_jobs int [not null]
  failed_job_ids text [not null]
  options text
  cancelled_at int
  created_at int [not null]
  finished_at int
}

Table failed_jobs {
  id bigint [pk, increment]
  uuid varchar [not null, unique]
  connection text [not null]
  queue text [not null]
  payload text [not null]
  exception text [not null]
  failed_at timestamp [not null]
}

Table categories {
  id bigint [pk, increment]
  name varchar(50) [not null]
  slug varchar(60) [not null, unique]
  icon varchar(50)
  icon_background varchar(20)
  description text
  image varchar(255)
  sort_order int [not null, default: 0]
  status varchar(20) [not null, default: 'active']
  created_at timestamp
  updated_at timestamp

  indexes {
    status
  }
}

Table subcategories {
  id bigint [pk, increment]
  category_id bigint [not null]
  name varchar(50) [not null]
  slug varchar(60) [not null, unique]
  description text
  sort_order int [not null, default: 0]
  status varchar(20) [not null, default: 'active']
  created_at timestamp
  updated_at timestamp

  indexes {
    category_id
    status
  }
}

Table tags {
  id bigint [pk, increment]
  name varchar(50) [not null, unique]
  slug varchar(60) [not null, unique]
  type varchar(30) [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    type
  }
}

Table amenities {
  id bigint [pk, increment]
  name varchar(50) [not null, unique]
  icon varchar(50) [not null]
  category varchar(30) [not null]
  created_at timestamp
  updated_at timestamp
}

Table locations {
  id bigint [pk, increment]
  name varchar(200) [not null]
  slug varchar(220) [not null, unique]
  category_id bigint [not null]
  subcategory_id bigint
  description text [not null]
  short_description varchar(500) [not null]
  address varchar(255) [not null]
  district varchar(50) [not null]
  ward varchar(50)
  latitude decimal(10,8) [not null]
  longitude decimal(11,8) [not null]
  phone varchar(20)
  email varchar(100)
  website varchar(255)
  opening_hours json
  price_min decimal(12,2)
  price_max decimal(12,2)
  price_level int
  avg_rating decimal(3,2) [not null, default: 0]
  review_count int [not null, default: 0]
  view_count int [not null, default: 0]
  favorite_count int [not null, default: 0]
  thumbnail varchar(255)
  images json
  video_url varchar(255)
  status varchar(20) [not null, default: 'active']
  is_featured boolean [not null, default: false]
  created_by bigint
  created_at timestamp
  updated_at timestamp

  indexes {
    category_id
    subcategory_id
    district
    avg_rating
    view_count
    status
    is_featured
  }

  Note: 'Checks: latitude[-90,90], longitude[-180,180], price_min/max non-negative and min<=max. Fulltext index: locations_search_fulltext'
}

Table location_tags {
  id bigint [pk, increment]
  location_id bigint [not null]
  tag_id bigint [not null]
  created_at timestamp [not null]

  indexes {
    (location_id, tag_id) [unique, name: 'uq_location_tag']
    created_at
  }
}

Table location_amenities {
  id bigint [pk, increment]
  location_id bigint [not null]
  amenity_id bigint [not null]
  created_at timestamp [not null]

  indexes {
    (location_id, amenity_id) [unique, name: 'uq_location_amenity']
    created_at
  }
}

Table search_logs {
  id bigint [pk, increment]
  user_id bigint
  session_id varchar(100) [not null]
  query varchar(255) [not null]
  results_count int [not null, default: 0]
  filters json
  created_at timestamp [not null]

  indexes {
    user_id
    session_id
    query
    created_at
  }

  Note: 'Postgres indexes: search_logs_query_trgm_idx (GIN trgm), search_logs_filters_gin_idx (jsonb_path_ops)'
}

Table notifications {
  id bigint [pk, increment]
  user_id bigint [not null]
  type varchar(30) [not null]
  title varchar(255) [not null]
