  }
}

Table crawl_sources {
  id bigint [pk, increment]
  name varchar(255) [not null, unique]
  type varchar(100) [not null]
  config_json json
  enabled boolean [not null, default: true]
  last_run_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: 'Crawler staging table created by database-seeders/11_crawl_staging_tables.sql. Used before admin review/publish.'
}

Table crawl_jobs {
  id bigint [pk, increment]
  source_id bigint [not null]
  status varchar(50) [not null, default: 'pending']
  started_at timestamp
  finished_at timestamp
  error_message text
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    source_id
  }
}

Table crawl_items {
  id bigint [pk, increment]
  source_id bigint
  job_id bigint
  entity_type varchar(100) [not null]
  external_id varchar(255)
  source_url text
  raw_payload json [not null]
  normalized_payload json
  status varchar(50) [not null, default: 'raw']
  duplicate_of_id bigint
  reviewed_by bigint
  reviewed_at timestamp
  published_entity_type varchar(100)
  published_entity_id bigint
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (source_id, external_id) [unique, name: 'crawl_items_source_external_unique']
    (entity_type, status)
    external_id
  }

  Note: 'Stores crawled Overpass/Pexels/Nominatim data in pending_review before publishing to locations/tours/blog_posts.'
}

Table crawl_logs {
  id bigint [pk, increment]
  job_id bigint
  level varchar(20) [not null]
  message text [not null]
  context_json json
  created_at timestamp [not null]

  indexes {
    job_id
  }
}

