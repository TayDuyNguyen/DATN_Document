  payment_method varchar(30) [not null]
  payment_status varchar(30) [not null, default: 'pending']
  payment_gateway varchar(50)
  gateway_response json
  paid_at timestamp
  refunded_at timestamp
  refund_reason text
  created_at timestamp
  updated_at timestamp

  indexes {
    booking_id
    payment_status
    payment_gateway
    created_at
    paid_at
  }

  Note: 'Checks: payment_status in (pending,success,failed,refunded), amount>=0. Partial index: payments_success_paid_idx'
}

