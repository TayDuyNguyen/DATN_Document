  icon_background varchar(20)
  sort_order int [not null, default: 0, unique]
  status varchar(20) [not null, default: 'active']
  created_at timestamp
  updated_at timestamp

  indexes {
    status
  }
}

Table tours {
  id bigint [pk, increment]
  name varchar(200) [not null]
  slug varchar(220) [not null, unique]
  tour_category_id bigint [not null]
  description text
  short_desc varchar(500)
  itinerary json
  inclusions json
  exclusions json
  price_adult decimal(12,2) [not null]
  price_child decimal(12,2) [not null, default: 0]
  price_infant decimal(12,2) [not null, default: 0]
  discount_percent int [not null, default: 0]
  duration varchar(50)
  start_time varchar(50)
  meeting_point varchar(255)
  max_people int [not null, default: 0]
  min_people int [not null, default: 1]
  available_from date
  available_to date
  thumbnail varchar(255)
  images json
  video_url varchar(255)
  status varchar(20) [not null, default: 'active']
  booking_availability varchar(20) [not null, default: 'open']
  is_featured boolean [not null, default: false]
  is_hot boolean [not null, default: false]
  view_count int [not null, default: 0]
  booking_count int [not null, default: 0]
  rating_count int [not null, default: 0]
  rating_avg decimal(3,2) [not null, default: 0]
  created_by bigint
  created_at timestamp
  updated_at timestamp

  indexes {
    tour_category_id
    status
    booking_availability
    is_featured
    is_hot
    price_adult
    (available_from, available_to)
    rating_avg
  }

  Note: 'Checks: people, non-negative prices and discount range, booking_availability in (open,sold_out). Fulltext: tours_search_fulltext. Composite index: tours_list_idx'
}

Table tour_schedules {
  id bigint [pk, increment]
  tour_id bigint [not null]
  start_date date [not null]
  end_date date [not null]
  max_people int [not null, default: 0]
  booked_people int [not null, default: 0]
  price_adult decimal(12,2)
  price_child decimal(12,2)
  price_infant decimal(12,2)
  status varchar(20) [not null, default: 'available']
  booking_availability varchar(20) [not null, default: 'open']
  departure_code varchar(50)
  departure_place varchar(255)
  booking_deadline datetime
  created_at timestamp
  updated_at timestamp

  indexes {
    (tour_id, start_date) [unique, name: 'uq_tour_schedule']
    start_date
    status
    booking_availability
  }

  Note: 'Check: max_people>=0 and booked_people>=0 and booked_people<=max_people. booking_availability: open|sold_out'
}

Table bookings {
  id bigint [pk, increment]
  booking_code varchar(20) [not null, unique]
  user_id bigint
  customer_name varchar(100) [not null]
  customer_email varchar(100) [not null]
  customer_phone varchar(20) [not null]
  customer_address text
  customer_note text
  total_amount decimal(12,2) [not null]
  discount_amount decimal(12,2) [not null, default: 0]
  final_amount decimal(12,2) [not null]
  deposit_amount decimal(12,2) [not null, default: 0]
  payment_method varchar(30) [not null]
  payment_status varchar(30) [not null, default: 'unpaid']
  booking_status varchar(30) [not null, default: 'pending']
  cancellation_reason text
  booked_at timestamp [not null]
  confirmed_at timestamp
  cancelled_at timestamp
  completed_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    booking_status
    payment_status
    booked_at
    created_at
    user_id
  }

  Note: 'Checks: amounts non-negative, payment_status in (pending,success,failed,refunded,unpaid,partially_paid). Composite index: bookings_status_booked_idx'
}

Table booking_items {
  id bigint [pk, increment]
  booking_id bigint [not null]
  tour_id bigint [not null]
  tour_schedule_id bigint [not null]
  item_type varchar(30) [not null, default: 'tour']
  item_name varchar(200) [not null]
  travel_date date [not null]
  quantity_adult int [not null, default: 0]
  quantity_child int [not null, default: 0]
  quantity_infant int [not null, default: 0]
  unit_price_adult decimal(12,0) [not null]
  unit_price_child decimal(12,0) [not null]
  unit_price_infant decimal(12,0) [not null]
  subtotal decimal(12,0) [not null]
  status varchar(30) [not null, default: 'pending']
  created_at timestamp
  updated_at timestamp

  indexes {
    (booking_id, tour_id)
    travel_date
  }
}

Table payments {
  id bigint [pk, increment]
  booking_id bigint [not null]
  transaction_code varchar(100) [not null, unique]
