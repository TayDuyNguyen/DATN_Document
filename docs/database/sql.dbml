// ============================================================
// DATABASE SCHEMA - WEBSITE DU LỊCH ĐÀ NẴNG "ĐÀ NẴNG TRIP"
// Stack: Laravel 11.x + MySQL 8.0
// Tổng: 24 bảng | Dịch vụ tour (không có point)
// ============================================================


// ============================================================
// BẢNG 1: users
// Mục đích: Tài khoản khách hàng và admin/staff
// ============================================================
Table users {
  id                bigint       [pk, note: 'Khóa chính, tự tăng']
  username          varchar(50)  [unique, note: 'Tên đăng nhập']
  email             varchar(100) [unique, note: 'Email đăng nhập']
  password          varchar(255) [note: 'Mật khẩu đã hash']
  full_name         varchar(100) [note: 'Họ tên đầy đủ']
  avatar            varchar(255) [note: 'URL ảnh đại diện']
  phone             varchar(20)  [note: 'Số điện thoại']
  birthdate         date         [note: 'Ngày sinh']
  gender            varchar(20)  [note: 'male | female | other']
  city              varchar(100) [note: 'Thành phố']
  role              varchar(20)  [note: 'user | admin | staff']
  status            varchar(20)  [note: 'active | banned']
  email_verified_at timestamp    [note: 'Thời điểm xác thực email']
  last_login_at     timestamp    [note: 'Lần đăng nhập cuối']
  remember_token    varchar(100) [note: 'Token ghi nhớ đăng nhập']
  created_at        timestamp
  updated_at        timestamp

  indexes {
    email
    status
    role
  }
}


// ============================================================
// BẢNG 2: categories
// Mục đích: Danh mục chính của địa điểm
// Ví dụ: Ăn uống | Khách sạn | Địa điểm tham quan
// ============================================================
Table categories {
  id          bigint       [pk]
  name        varchar(50)  [note: 'Tên danh mục']
  slug        varchar(60)  [unique, note: 'URL thân thiện']
  icon        varchar(50)  [note: 'FontAwesome icon']
  description text
  image       varchar(255)
  sort_order  int
  status      varchar(20)  [note: 'active | inactive']
  created_at  timestamp
  updated_at  timestamp

  indexes { status }
}


// ============================================================
// BẢNG 3: subcategories
// Mục đích: Danh mục con
// Ví dụ: Ăn uống → Hải sản, Nhà hàng, Quán cà phê
// ============================================================
Table subcategories {
  id          bigint      [pk]
  category_id bigint      [note: 'FK → categories.id']
  name        varchar(50)
  slug        varchar(60) [unique]
  description text
  sort_order  int
  status      varchar(20) [note: 'active | block | pending']
  created_at  timestamp
  updated_at  timestamp

  indexes {
    category_id
    status
  }
}


// ============================================================
// BẢNG 4: locations (BẢNG TRUNG TÂM)
// Mục đích: Địa điểm du lịch, ăn uống, khách sạn tại Đà Nẵng
// ============================================================
Table locations {
  id                bigint        [pk]
  name              varchar(200)
  slug              varchar(220)  [unique]
  category_id       bigint        [note: 'FK → categories.id']
  subcategory_id    bigint        [note: 'FK → subcategories.id, nullable']
  description       text
  short_description varchar(500)
  address           varchar(255)
  district          varchar(50)   [note: 'Hải Châu | Sơn Trà | Ngũ Hành Sơn | Cẩm Lệ | Thanh Khê | Liên Chiểu']
  ward              varchar(50)
  latitude          decimal(10,8) [note: 'Vĩ độ GPS']
  longitude         decimal(11,8) [note: 'Kinh độ GPS']
  phone             varchar(20)
  email             varchar(100)
  website           varchar(255)
  opening_hours     text          [note: 'JSON: {"mon":"08:00-22:00","sun":"closed"}']
  price_min         decimal(12,0)
  price_max         decimal(12,0)
  price_level       tinyint       [note: '1=Rẻ | 2=Trung bình | 3=Cao | 4=Sang trọng']
  avg_rating        decimal(3,2)  [note: '0.00-5.00, tự cập nhật khi duyệt rating']
  review_count      int
  view_count        int
  favorite_count    int
  thumbnail         varchar(255)
  images            text          [note: 'JSON array URL ảnh']
  video_url         varchar(255)
  status            varchar(20)   [note: 'active | inactive']
  is_featured       boolean
  created_by        bigint        [note: 'FK → users.id']
  created_at        timestamp
  updated_at        timestamp

  indexes {
    category_id
    subcategory_id
    district
    status
    is_featured
    avg_rating
    view_count
  }
}


// ============================================================
// BẢNG 5: tags
// Mục đích: Nhãn mô tả đặc điểm địa điểm
// Ví dụ: view-đẹp, giá-rẻ, wifi-miễn-phí, gần-biển
// ============================================================
Table tags {
  id         bigint      [pk]
  name       varchar(50) [unique]
  slug       varchar(60) [unique]
  type       varchar(30) [note: 'cuisine | service | feature | atmosphere']
  created_at timestamp
  updated_at timestamp
}


// ============================================================
// BẢNG 6: location_tags (Trung gian locations - tags)
// ============================================================
Table location_tags {
  id          bigint    [pk]
  location_id bigint    [note: 'FK → locations.id']
  tag_id      bigint    [note: 'FK → tags.id']
  created_at  timestamp

  indexes {
    (location_id, tag_id) [unique, name: 'uq_location_tag']
  }
}


// ============================================================
// BẢNG 7: amenities
// Mục đích: Tiện ích của địa điểm
// Ví dụ: WiFi miễn phí, Bãi đỗ xe, Điều hòa
// ============================================================
Table amenities {
  id         bigint      [pk]
  name       varchar(50) [unique]
  icon       varchar(50)
  category   varchar(30) [note: 'connectivity | parking | comfort | payment']
  created_at timestamp
  updated_at timestamp
}


// ============================================================
// BẢNG 8: location_amenities (Trung gian locations - amenities)
// ============================================================
Table location_amenities {
  id          bigint    [pk]
  location_id bigint    [note: 'FK → locations.id']
  amenity_id  bigint    [note: 'FK → amenities.id']
  created_at  timestamp

  indexes {
    (location_id, amenity_id) [unique, name: 'uq_location_amenity']
  }
}


// ============================================================
// BẢNG 9: tour_categories
// Mục đích: Danh mục tour
// Ví dụ: Tour tham quan | Tour ẩm thực | Tour sinh thái | Tour văn hóa
// ============================================================
Table tour_categories {
  id          bigint      [pk]
  name        varchar(50) [unique]
  slug        varchar(60) [unique]
  description text
  icon        varchar(50)
  sort_order  int
  status      varchar(20) [note: 'active | inactive']
  created_at  timestamp
  updated_at  timestamp

  indexes { status }
}


// ============================================================
// BẢNG 10: tours (Sản phẩm tour du lịch)
// ============================================================
Table tours {
  id               bigint        [pk]
  name             varchar(200)
  slug             varchar(220)  [unique]
  tour_category_id bigint        [note: 'FK → tour_categories.id']
  description      text
  short_desc       varchar(500)
  itinerary        text          [note: 'Lịch trình chi tiết (JSON hoặc HTML)']
  inclusions       text          [note: 'Bao gồm (JSON array)']
  exclusions       text          [note: 'Không bao gồm (JSON array)']
  price_adult      decimal(12,0) [note: 'Giá người lớn (VNĐ)']
  price_child      decimal(12,0) [note: 'Giá trẻ em 5-11 tuổi (VNĐ)']
  price_infant     decimal(12,0) [note: 'Giá em bé 0-4 tuổi (VNĐ)']
  discount_percent int           [note: 'Phần trăm giảm giá (0-100)']
  duration         varchar(50)   [note: 'Ví dụ: 1 ngày, 2 ngày 1 đêm']
  start_time       varchar(50)   [note: 'Thời gian khởi hành']
  meeting_point    varchar(255)  [note: 'Điểm tập trung']
  max_people       int           [note: '0 = không giới hạn']
  min_people       int           [note: 'Số người tối thiểu để tour chạy']
  available_from   date
  available_to     date
  thumbnail        varchar(255)
  images           text          [note: 'JSON array URL ảnh']
  video_url        varchar(255)
  location_ids     text          [note: 'JSON array ID các địa điểm trong tour']
  status           varchar(20)   [note: 'active | inactive | sold_out']
  is_featured      boolean
  is_hot           boolean       [note: 'Tour hot/trending']
  view_count       int
  booking_count    int           [note: 'Số lượt đặt thành công']
  created_by       bigint        [note: 'FK → users.id']
  created_at       timestamp
  updated_at       timestamp

  indexes {
    tour_category_id
    status
    is_featured
    is_hot
    price_adult
    available_from
    available_to
  }
}


// ============================================================
// BẢNG 11: tour_schedules
// Mục đích: Lịch khởi hành cụ thể của từng tour
// ============================================================
Table tour_schedules {
  id           bigint        [pk]
  tour_id      bigint        [note: 'FK → tours.id']
  start_date   date          [note: 'Ngày khởi hành']
  end_date     date          [note: 'Ngày kết thúc']
  max_people   int           [note: 'Số lượng tối đa cho ngày này']
  booked_people int          [note: 'Số người đã đặt']
  price_adult  decimal(12,0) [note: 'Giá đặc biệt cho ngày này (override tour price)']
  price_child  decimal(12,0)
  price_infant decimal(12,0)
  status       varchar(20)   [note: 'available | full | cancelled']
  created_at   timestamp
  updated_at   timestamp

  indexes {
    tour_id
    start_date
    status
    (tour_id, start_date) [unique, name: 'uq_tour_schedule']
  }
}


// ============================================================
// BẢNG 12: bookings (Đơn đặt chỗ - QUAN TRỌNG)
// Mục đích: Lưu toàn bộ đơn hàng đặt tour
// Luồng: pending → confirmed → completed | cancelled
// ============================================================
Table bookings {
  id                bigint        [pk]
  booking_code      varchar(20)   [unique, note: 'Mã đơn: DANANG-YYYYMMDD-XXXX']
  user_id           bigint        [note: 'FK → users.id, NULL nếu khách đặt không tài khoản']
  customer_name     varchar(100)
  customer_email    varchar(100)
  customer_phone    varchar(20)
  customer_address  text
  customer_note     text          [note: 'Yêu cầu đặc biệt']
  total_amount      decimal(12,0) [note: 'Tổng tiền trước giảm giá']
  discount_amount   decimal(12,0) [note: 'Số tiền giảm']
  final_amount      decimal(12,0) [note: 'Thành tiền sau giảm giá']
  deposit_amount    decimal(12,0) [note: 'Tiền đặt cọc (nếu có)']
  payment_method    varchar(30)   [note: 'momo | vnpay | bank | cash']
  payment_status    varchar(30)   [note: 'unpaid | paid | failed | refunded']
  booking_status    varchar(30)   [note: 'pending | confirmed | cancelled | completed']
  cancellation_reason text
  booked_at         timestamp
  confirmed_at      timestamp
  cancelled_at      timestamp
  completed_at      timestamp
  created_at        timestamp
  updated_at        timestamp

  indexes {
    booking_code
    user_id
    customer_email
    customer_phone
    booking_status
    payment_status
    booked_at
  }
}


// ============================================================
// BẢNG 13: booking_items
// Mục đích: Chi tiết từng dòng trong đơn hàng
// ============================================================
Table booking_items {
  id                bigint        [pk]
  booking_id        bigint        [note: 'FK → bookings.id']
  tour_id           bigint        [note: 'FK → tours.id']
  tour_schedule_id  bigint        [note: 'FK → tour_schedules.id']
  item_type         varchar(30)   [note: 'tour | hotel | transport | extra']
  item_name         varchar(200)
  travel_date       date
  quantity_adult    int
  quantity_child    int
  quantity_infant   int
  unit_price_adult  decimal(12,0)
  unit_price_child  decimal(12,0)
  unit_price_infant decimal(12,0)
  subtotal          decimal(12,0)
  status            varchar(30)   [note: 'pending | confirmed | cancelled | completed']
  created_at        timestamp
  updated_at        timestamp

  indexes {
    booking_id
    tour_id
    tour_schedule_id
    travel_date
  }
}


// ============================================================
// BẢNG 14: payments
// Mục đích: Lịch sử giao dịch thanh toán
// ============================================================
Table payments {
  id               bigint        [pk]
  booking_id       bigint        [note: 'FK → bookings.id']
  transaction_code varchar(100)  [unique, note: 'Mã giao dịch từ cổng thanh toán']
  amount           decimal(12,0)
  payment_method   varchar(30)
  payment_status   varchar(30)   [note: 'pending | success | failed | refunded']
  payment_gateway  varchar(50)   [note: 'momo | vnpay | zalopay']
  gateway_response text          [note: 'JSON response từ cổng thanh toán']
  paid_at          timestamp
  refunded_at      timestamp
  refund_reason    text
  created_at       timestamp
  updated_at       timestamp

  indexes {
    booking_id
    transaction_code
    payment_status
  }
}


// ============================================================
// BẢNG 15: ratings
// Mục đích: Đánh giá địa điểm hoặc tour (không có point)
// Ràng buộc: Chỉ đánh giá sau khi có booking hợp lệ
// ============================================================
Table ratings {
  id              bigint       [pk]
  user_id         bigint       [note: 'FK → users.id']
  location_id     bigint       [note: 'FK → locations.id, nullable']
  tour_id         bigint       [note: 'FK → tours.id, nullable']
  booking_id      bigint       [note: 'FK → bookings.id, nullable — chỉ đánh giá sau booking']
  score           tinyint      [note: '1-5 sao']
  comment         text
  image_urls      text         [note: 'JSON array, tối đa 5 ảnh']
  status          varchar(20)  [note: 'pending | approved | rejected']
  rejected_reason varchar(255)
  approved_by     bigint       [note: 'FK → users.id, nullable']
  approved_at     timestamp
  helpful_count   int
  created_at      timestamp
  updated_at      timestamp

  indexes {
    user_id
    location_id
    tour_id
    booking_id
    status
    score
    created_at
    (user_id, location_id) [unique, name: 'uq_user_location_rating']
    (user_id, tour_id)     [unique, name: 'uq_user_tour_rating']
  }
}


// ============================================================
// BẢNG 16: rating_images
// Mục đích: Ảnh đính kèm trong bài đánh giá (tách riêng để dễ quản lý)
// ============================================================
Table rating_images {
  id         bigint       [pk]
  rating_id  bigint       [note: 'FK → ratings.id']
  image_url  varchar(255)
  sort_order tinyint
  created_at timestamp

  indexes { rating_id }
}


// ============================================================
// BẢNG 17: favorites
// Mục đích: Địa điểm yêu thích của user
// ============================================================
Table favorites {
  id          bigint    [pk]
  user_id     bigint    [note: 'FK → users.id']
  location_id bigint    [note: 'FK → locations.id']
  created_at  timestamp

  indexes {
    (user_id, location_id) [unique, name: 'uq_user_location_fav']
    location_id
  }
}


// ============================================================
// BẢNG 18: blog_categories
// Mục đích: Danh mục bài viết blog (tách biệt với categories địa điểm)
// Ví dụ: Ẩm thực | Lưu trú | Vui chơi | Kinh nghiệm | Tin tức
// ============================================================
Table blog_categories {
  id          bigint      [pk]
  name        varchar(50) [unique]
  slug        varchar(60) [unique]
  description text
  created_at  timestamp
  updated_at  timestamp
}


// ============================================================
// BẢNG 19: blog_posts
// Mục đích: Bài viết cẩm nang du lịch Đà Nẵng
// ============================================================
Table blog_posts {
  id             bigint       [pk]
  title          varchar(255)
  slug           varchar(280) [unique]
  excerpt        varchar(500)
  content        longtext
  featured_image varchar(255)
  author_id      bigint       [note: 'FK → users.id']
  view_count     int
  status         varchar(20)  [note: 'draft | published | archived']
  published_at   timestamp
  created_at     timestamp
  updated_at     timestamp

  indexes {
    author_id
    status
    published_at
  }
}


// ============================================================
// BẢNG 20: blog_post_categories (Trung gian blog_posts - blog_categories)
// ============================================================
Table blog_post_categories {
  id               bigint [pk]
  post_id          bigint [note: 'FK → blog_posts.id']
  blog_category_id bigint [note: 'FK → blog_categories.id']

  indexes {
    (post_id, blog_category_id) [unique, name: 'uq_post_blog_category']
  }
}


// ============================================================
// BẢNG 21: views
// Mục đích: Ghi lại lượt xem địa điểm (kể cả guest)
// ============================================================
Table views {
  id          bigint       [pk]
  user_id     bigint       [note: 'FK → users.id, NULL nếu là guest']
  location_id bigint       [note: 'FK → locations.id']
  session_id  varchar(100) [note: 'Session ID để track guest']
  time_spent  int          [note: 'Thời gian xem (giây)']
  created_at  timestamp

  indexes {
    user_id
    location_id
    created_at
    session_id
  }
}


// ============================================================
// BẢNG 22: search_logs
// Mục đích: Lịch sử tìm kiếm — phân tích từ khóa phổ biến
// ============================================================
Table search_logs {
  id            bigint       [pk]
  user_id       bigint       [note: 'FK → users.id, NULL nếu là guest']
  session_id    varchar(100)
  query         varchar(255)
  results_count int
  filters       text         [note: 'JSON filters đã áp dụng']
  created_at    timestamp

  indexes {
    user_id
    query
    created_at
    session_id
  }
}


// ============================================================
// BẢNG 23: notifications
// Mục đích: Thông báo hệ thống gửi đến user
// Loại: booking_confirmed | booking_cancelled | payment_success | rating_approved
// ============================================================
Table notifications {
  id         bigint       [pk]
  user_id    bigint       [note: 'FK → users.id']
  type       varchar(30)  [note: 'booking_confirmed | booking_cancelled | payment_success | rating_approved']
  title      varchar(255)
  content    text
  data       text         [note: 'JSON data bổ sung']
  is_read    boolean
  read_at    timestamp
  created_at timestamp

  indexes {
    (user_id, is_read)
    created_at
  }
}


// ============================================================
// BẢNG 24: contacts
// Mục đích: Form liên hệ từ khách hàng
// ============================================================
Table contacts {
  id         bigint       [pk]
  name       varchar(100)
  email      varchar(100)
  phone      varchar(20)
  subject    varchar(200)
  message    text
  status     varchar(20)  [note: 'new | read | replied']
  replied_by bigint       [note: 'FK → users.id, nullable']
  replied_at timestamp
  reply      text
  created_at timestamp
  updated_at timestamp

  indexes {
    status
    created_at
  }
}


// ============================================================
// RELATIONSHIPS
// Ký hiệu: < = one-to-many
// ============================================================

// --- users ---
Ref: users.id < locations.created_by
Ref: users.id < tours.created_by
Ref: users.id < bookings.user_id
Ref: users.id < ratings.user_id
Ref: users.id < ratings.approved_by
Ref: users.id < favorites.user_id
Ref: users.id < views.user_id
Ref: users.id < notifications.user_id
Ref: users.id < search_logs.user_id
Ref: users.id < blog_posts.author_id
Ref: users.id < contacts.replied_by

// --- categories & subcategories ---
Ref: categories.id < subcategories.category_id
Ref: categories.id < locations.category_id
Ref: subcategories.id < locations.subcategory_id

// --- locations ---
Ref: locations.id < ratings.location_id
Ref: locations.id < favorites.location_id
Ref: locations.id < views.location_id
Ref: locations.id < location_tags.location_id
Ref: locations.id < location_amenities.location_id

// --- tags & amenities ---
Ref: tags.id < location_tags.tag_id
Ref: amenities.id < location_amenities.amenity_id

// --- tours ---
Ref: tour_categories.id < tours.tour_category_id
Ref: tours.id < tour_schedules.tour_id
Ref: tours.id < booking_items.tour_id
Ref: tours.id < ratings.tour_id

// --- bookings ---
Ref: bookings.id < booking_items.booking_id
Ref: bookings.id < payments.booking_id
Ref: bookings.id < ratings.booking_id
Ref: tour_schedules.id < booking_items.tour_schedule_id

// --- ratings ---
Ref: ratings.id < rating_images.rating_id

// --- blog ---
Ref: blog_posts.id < blog_post_categories.post_id
Ref: blog_categories.id < blog_post_categories.blog_category_id
